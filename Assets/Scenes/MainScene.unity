  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The Borgata 777 Respin 2X symbol appears only on Reel 3 and is wild for
    non-Borgata symbols, multiplying winning combinations by 2X. The Borgata 777
    Respin 3X symbol appears only on Reel 2 and is wild for non-Borgata symbols,
    multiplying winning combinations by 3X. The Borgata 777 Respin 5X symbol appears
    only on Reel 1 and is wild for non-Borgata symbols, multiplying winning combinations
    by 5X. The Borgata 777 Respin 10X symbol appears only on Reel 1 and is wild for
    non-Borgata symbols, multiplying winning combinations by 10X. A winning combination
    consisting only of multiplier symbols will award the paytable value and will
    not apply any multiplier. A winning combination containing two multiplier symbols
    together with Borgata or Seven symbols applies the multipliers multiplicatively.
    For example, a payline containing both a 5X and a 3X multiplier awards a 15X
    winning combination. Fixed Multiplier Symbols landing on all three reels along
    any active payline award the Jackpot prizes (see Paytable). 30X is the maximum
    multiplier that can be awarded.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
